NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
ADMIN_WEB_ORIGIN=http://127.0.0.1:5174
MONGODB_URI=mongodb://127.0.0.1:27018/aibus?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6380
# Generate at least 48 random characters. Never use this literal placeholder.
JWT_SECRET=replace-with-a-random-secret-of-at-least-48-characters
UPLOAD_DIR=./var/uploads
TRUST_PROXY=0
# Password reset is unavailable until SMTP is configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=no-reply@aibus.example
# Razorpay: this integration accepts Test Mode keys only. Secrets stay on the backend.
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_test_key_secret
# RAZORPAY_WEBHOOK_SECRET=use-a-random-secret-also-set-in-the-razorpay-dashboard
# One-time bootstrap only; remove after creating the platform admin.
# BOOTSTRAP_EMAIL=admin@example.com
# BOOTSTRAP_NAME=Platform administrator
# BOOTSTRAP_PASSWORD=use-a-unique-random-password-at-least-16-characters
