NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
ADMIN_WEB_ORIGIN=http://127.0.0.1:5174
# Set only after the real agent dashboard origin is approved; no wildcard.
# AGENT_WEB_ORIGIN=http://127.0.0.1:5175
# Production agent and API hosts must use HTTPS and a same-site/proxied deployment
# for the existing SameSite=Strict HttpOnly refresh cookie.
MONGODB_URI=mongodb://127.0.0.1:27018/aibus?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6380
REDIS_PREFIX=aibus
# Generate at least 48 random characters. Never use this literal placeholder.
JWT_SECRET=replace-with-a-random-secret-of-at-least-48-characters
UPLOAD_DIR=./var/uploads
TRUST_PROXY=0
# Password reset is unavailable until SMTP is configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=no-reply@aibus.example
# Isolated financial test operations only. Rejected when NODE_ENV=production.
# Public API test refunds also require this flag plus Razorpay Test Mode keys.
# Operator custody/funding policy and agency grants must also be enabled explicitly.
FINANCE_TEST_MODE=false
# Razorpay: this integration accepts Test Mode keys only. Secrets stay on the backend.
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_test_key_secret
# RAZORPAY_WEBHOOK_SECRET=use-a-random-secret-also-set-in-the-razorpay-dashboard
# One-time bootstrap only; remove after creating the platform admin.
# BOOTSTRAP_EMAIL=admin@example.com
# BOOTSTRAP_NAME=Platform administrator
# BOOTSTRAP_PASSWORD=use-a-unique-random-password-at-least-16-characters
# Phase 6 operational diagnostics (defaults suit development; tune for production scale).
# OPS_SLOW_MS=1000       # Flag API responses slower than this (ms). Default: 1000.
# OPS_STUCK_MS=900000    # Treat pending bookings older than this as stale (ms). Default: 15 minutes.
# OPS_JOB_LAG_MS=180000  # Raise job-overdue alert when last run is older than this (ms). Default: 3 minutes.

# Operational diagnostics (application-local; external alert delivery is not configured)
OPS_SLOW_MS=1000
OPS_STUCK_MS=900000
OPS_JOB_LAG_MS=180000

# Phase 7: disabled in ordinary CRS environments. Use only a separate disposable
# replica-set database named aibus_public_sandbox_*; never point it at live data.
PUBLIC_API_SANDBOX=false
# PUBLIC_API_JWT_SECRET=use-a-separate-random-secret-of-at-least-64-characters
# PUBLIC_WEBHOOK_SIGNING_KEY=use-a-separate-64-character-lowercase-hex-key
# PUBLIC_WEBHOOK_ALLOWED_HOSTS=exact-approved-sandbox-partner-host.example

# API Partner web portal (separate from machine-to-machine credentials)
PARTNER_WEB_ORIGIN=http://127.0.0.1:5176
