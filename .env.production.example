# Copy to /opt/bookmybus-crs/shared/api.env ON THE VPS, mode 0600.
# Bare values only: no surrounding quotes, multiline values or shell expansion.
NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://bookmybus.pro
ADMIN_WEB_ORIGIN=https://admin.bookmybus.pro
PARTNER_WEB_ORIGIN=https://partner.bookmybus.pro
TRUST_PROXY=2
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_HOST/aibus?retryWrites=true&w=majority
REDIS_URL=rediss://default:REPLACE_URL_ENCODED_PASSWORD@REPLACE_HOST:6379
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
PUBLIC_API_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
PUBLIC_WEBHOOK_SIGNING_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
PUBLIC_API_SANDBOX=false
FINANCE_TEST_MODE=false
MAIL_FROM=no-reply@bookmybus.pro
# Optional but required for the associated email/payment features:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
